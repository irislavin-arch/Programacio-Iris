dni=input('Escriu el teu DNI complet i sense espais\n')

numero=int(dni[:8])
resta=numero % 23

lletres=['T', 'R', 'W', 'A', 'G', 'M', 'Y', 'F', 'P', 'D', 'X', 'B', 'N', 'J', 'Z', 'S', 'Q', 'V', 'H', 'L', 'C', 'K', 'E']

lletra_correcta=lletres[resta]
lletra_escrita=dni[8].upper()

if lletra_escrita==lletra_correcta:
    print('El DNI és correcte')
else:
    print('Està malament. La lletra correcta és:', lletra_correcta)
    print('El DNI correcte seria:',dni[:8]+lletra_correcta)